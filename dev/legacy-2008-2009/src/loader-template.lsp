; KKUMPLE_LEGACY17_EXPERIMENTAL - Kkumple test loader for AutoCAD 2008 (R17.1) / 2009 (R17.2).
; Generated by the Kkumple 2008-2009 connector. Do not edit; reinstall to regenerate.
; Modules: original 2010-2012 family files, unmodified. Menu: converted CUI with BITMAP icons.
(vl-load-com)
(setq kkl:root "@@ROOT@@")
; Diagnostics: kkl-log.txt plus the connector copy that sends reports to the developer.
(defun kkl:log (s / f)
  (if (setq f (open (strcat kkl:root "\\kkl-log.txt") "a"))
    (progn (write-line (strcat (menucmd "M=$(edtime,$(getvar,date),YYYY-MO-DD HH:MM:SS)") " " s) f) (close f))))
(defun kkl:send (reason delay / exe)
  (setq exe (strcat kkl:root "\\@@REPORTER@@"))
  (if (findfile exe)
    (vl-catch-all-apply 'startapp (list exe (strcat "--send-report " reason " --delay " (itoa delay))))
    (kkl:log (strcat "reporter missing: " exe))))
(kkl:log (strcat "loader loaded; product=" (vl-princ-to-string (vl-catch-all-apply 'vlax-product-key nil)) " acadver=" (vl-princ-to-string (getvar "ACADVER"))))
(if (and (eq (type (vlax-product-key)) 'STR)
         (or (vl-string-search "\\R17.1\\" (strcase (vlax-product-key)))
             (vl-string-search "\\R17.2\\" (strcase (vlax-product-key)))))
 (progn
(setq kkl:modules (strcat kkl:root "\\modules"))
(setq kkl:release (if (vl-string-search "\\R17.1\\" (strcase (vlax-product-key))) "2008" "2009"))
(setq kkl:module-list '("KkCivil0.dll" "KkDraw0.dll" "KkExcel0.dll" "KkInquiry0.dll" "KkLayer0.dll" "KkModify20.dll" "KkModify0.dll" "KkPoly0.dll" "KkText0.dll" "KkUtil0.dll"))
(setq kkl:commands '(@@COMMANDS@@))
(defun kkl:msg (s) (kkl:log s) (princ (strcat "\n[Kkumple 2008-2009 TEST] " s)))
(defun kkl:cadlog-on (/ dir r)
  (setq dir (strcat kkl:root "\\cadlog"))
  (if (not (vl-file-directory-p dir)) (vl-mkdir dir))
  (setq r (vl-catch-all-apply '(lambda () (setvar "LOGFILEPATH" (strcat dir "\\")) (setvar "LOGFILEMODE" 1)) nil))
  (kkl:log (if (vl-catch-all-error-p r) (strcat "command-line log failed: " (vl-catch-all-error-message r)) (strcat "command-line log on: " (vl-princ-to-string (getvar "LOGFILEPATH"))))))
(defun kkl:path-key (p) (strcase (vl-string-translate "/" "\\" p)))
(defun kkl:netload (p / r)
  (if (not (findfile p)) (progn (kkl:msg (strcat "Missing module: " p)) nil)
    (progn
      (setq r (vl-catch-all-apply '(lambda () (vl-cmdf "_.NETLOAD" p)) nil))
      (if (vl-catch-all-error-p r) (progn (kkl:msg (strcat "NETLOAD failed: " p " - " (vl-catch-all-error-message r))) nil) (progn (kkl:log (strcat "NETLOAD issued: " p " -> " (vl-princ-to-string r))) T)))))
(defun kkl:menu-group (/ found item)
  (vlax-for item (vla-get-menugroups (vlax-get-acad-object)) (if (equal (strcase (vla-get-name item)) "KKUMPLE") (setq found item)))
  found)
(defun kkl:menu-ours-p (g / fn)
  (setq fn (vl-catch-all-apply 'vla-get-menufilename (list g)))
  (and (eq (type fn) 'STR) (eq (vl-string-search (kkl:path-key (strcat kkl:root "\\menus\\")) (kkl:path-key fn)) 0)))
(defun kkl:menuload (y / file r g)
  (setq file (strcat kkl:root "\\menus\\" y "\\Kkumple.cui"))
  (if (findfile file) (progn
    (setq r (vl-catch-all-apply '(lambda () (vl-cmdf "_.MENULOAD" file)) nil))
    (setq g (kkl:menu-group))
    (if (and (not (vl-catch-all-error-p r)) g (kkl:menu-ours-p g)) y nil))))
(defun kkl:menubar (g / pm r)
  (setq pm (vl-catch-all-apply 'vla-item (list (vla-get-menus g) 0)))
  (if (and (not (vl-catch-all-error-p pm)) (eq (vla-get-OnMenuBar pm) :vlax-false))
    (progn (setq r (vl-catch-all-apply 'vla-InsertInMenuBar (list pm (vla-get-count (vla-get-menubar (vlax-get-acad-object))))))
      (if (vl-catch-all-error-p r) (kkl:msg "Pull-down menu could not be added to the menu bar.")))))
(defun kkl:ensure-menu (/ g used)
  (setq g (kkl:menu-group))
  (cond
    ((and g (not (kkl:menu-ours-p g))) (kkl:msg "Another KKUMPLE menu group is loaded. It was not changed.") "other")
    (g (kkl:menubar g) "kept")
    (T
      (setq used (kkl:menuload kkl:release))
      (if (and (not used) (equal kkl:release "2009")) (progn (kkl:msg "Ribbon menu was not accepted; loading menu without ribbon.") (setq used (kkl:menuload "2008"))))
      (if used (progn (kkl:menubar (kkl:menu-group)) (strcat "loaded-" used)) (progn (kkl:msg "Menu load failed. Commands can still be typed.") "failed")))))
(defun kkl:write-report (menu missing ok-count / f)
  (setq f (open (strcat kkl:root "\\load-report-" kkl:release ".txt") "w"))
  (if f (progn
    (write-line "Kkumple 2008-2009 test load report" f)
    (write-line (strcat "product=" (vlax-product-key)) f)
    (write-line (strcat "acadver=" (getvar "ACADVER")) f)
    (write-line (strcat "date=" (rtos (getvar "CDATE") 2 6)) f)
    (write-line (strcat "menu=" menu) f)
    (write-line (strcat "registered=" (itoa ok-count) "/" (itoa (length kkl:commands))) f)
    (foreach c missing (write-line (strcat "missing " c) f))
    (close f))))
(defun kkl:initialize-work (/ core menu missing ok-count)
  (cond
    ((vl-bb-ref 'kkumple-legacy17-ready) (setq *kkumple-legacy17-ready* T) (kkl:ensure-menu))
    ((and (getcname "DREAM_ART") (not (vl-bb-ref 'kkumple-legacy17-loading)))
      (kkl:msg "Existing DreamPlus commands are active. Remove its startup registration first."))
    (T
      (vl-bb-set 'kkumple-legacy17-loading T)
      (kkl:cadlog-on)
      (setq core (kkl:netload (strcat kkl:modules "\\KkCore0.dll")))
      (if core (foreach p kkl:module-list (kkl:netload (strcat kkl:modules "\\" p))))
      (setq menu (kkl:ensure-menu) ok-count 0)
      (foreach c kkl:commands (if (getcname c) (setq ok-count (1+ ok-count)) (setq missing (cons c missing))))
      (kkl:write-report menu (reverse missing) ok-count)
      (if (> ok-count 0)
        (progn (vl-bb-set 'kkumple-legacy17-ready T) (setq *kkumple-legacy17-ready* T)
          (kkl:msg (strcat "Registered " (itoa ok-count) " of " (itoa (length kkl:commands)) " commands. Menu: " menu ". Type KKREPORT for details.")))
        (kkl:msg "No Kkumple command was registered on this CAD. Type KKREPORT and send the report file.")))))
(defun kkl:initialize (/ r)
  (if (not *kkumple-legacy17-initializing*) (progn
    (setq *kkumple-legacy17-initializing* T)
    (setq r (vl-catch-all-apply 'kkl:initialize-work nil))
    (setq *kkumple-legacy17-initializing* nil)
    (if (vl-catch-all-error-p r) (kkl:msg (strcat "Initialization failed: " (vl-catch-all-error-message r))))
    (if (not (vl-bb-ref 'kkumple-legacy17-sent)) (progn (vl-bb-set 'kkumple-legacy17-sent T) (kkl:send "cad-start" 20)))))
  (princ))
(defun kkl:run (cmd)
  (if (not (vl-bb-ref 'kkumple-legacy17-ready)) (kkl:initialize))
  (if (getcname cmd) (vl-cmdf cmd) (kkl:msg (strcat cmd " is not available on this CAD version in the test build.")))
  (princ))
(defun c:KKLOAD () (kkl:initialize) (princ))
(defun c:KKREPORT () (kkl:msg (strcat "Report: " kkl:root "\\load-report-" kkl:release ".txt")) (kkl:send "kkreport" 3) (startapp "notepad.exe" (strcat kkl:root "\\load-report-" kkl:release ".txt")) (princ))
(defun c:KKUNLOADMENU (/ g) (setq g (kkl:menu-group)) (if (and g (kkl:menu-ours-p g)) (progn (vla-unload g) (kkl:msg "Kkumple menu unloaded. You can now run the uninstaller.")) (kkl:msg "Kkumple menu is not loaded.")) (princ))
@@ALIASES@@
(if (not (boundp '*kkl-startup-hook-installed*)) (progn
  (setq kkl:prior-startup (if (boundp 's::startup) s::startup nil))
  (defun-q s::startup (/ kkl:startup-result)
    (if kkl:prior-startup (progn (setq kkl:startup-result (vl-catch-all-apply 'kkl:prior-startup nil)) (if (vl-catch-all-error-p kkl:startup-result) (princ (strcat "\n[Kkumple] Previous startup: " (vl-catch-all-error-message kkl:startup-result))))))
    (kkl:initialize) (princ))
  (setq *kkl-startup-hook-installed* T)))
 )
 (progn (kkl:log "gate: not AutoCAD R17.1/R17.2, skipped") (kkl:send "gate-skip" 5)))
(princ)
